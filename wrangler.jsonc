{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tangossip",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "tangossip-db", "database_id": "1d0165f2-c9c0-456f-9142-f95a931c02b9", "migrations_dir": "migrations" }
  ],
  // Secrets: RESEND_API_KEY, HASH_KEY, TURNSTILE_SECRET (optional). MAIL_FROM empty disables mail.
  "vars": { "MAIL_FROM": "", "TURNSTILE_SITE_KEY": "" }
}
